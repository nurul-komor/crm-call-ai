# =============================================================================
# VoiceFlow AI — environment variables (template; copy to .env and fill in)
# .env is GITIGNORED. Do NOT commit secrets.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---------- Backend ----------
BACKEND_PORT=4000
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173

# ---------- Mongo ----------
# Pick one and uncomment:
#   - Host Mongo (default, if you have one on :27017)
# MONGO_URI=mongodb://localhost:27017/ai-call
#   - docker-compose Mongo (remapped to :27018 to avoid host collision)
# MONGO_URI=mongodb://app:app@localhost:27018/ai-call?authSource=admin
#   - Atlas (production-like)
MONGO_URI=

# ---------- Redis ----------
# Host Redis (default): :6379
# docker-compose Redis (remapped): :6380
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=vf

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL=1h
BCRYPT_ROUNDS=12

# ---------- Crypto ----------
# 32-byte base64-encoded master key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_VERSION=1

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_AMD_MODE=DetectMessageEnd

# ---------- ElevenLabs ----------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000
ELEVENLABS_OPTIMIZE_LATENCY=3

# ---------- OpenAI ----------
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-transcribe

# ---------- Storage ----------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
SIGNED_URL_TTL_SEC=900

# ---------- Mail (Mailhog local) ----------
# Host mailhog default: 1025 (SMTP) / 8025 (UI)
# docker-compose mailhog: 1026 / 8026
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VoiceFlow AI <noreply@voiceflow.ai>"

# ---------- Rate limit / CORS ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGINS=http://localhost:5173

# ---------- Call worker ----------
CALL_WORKER_PORT=4100
CALL_WORKER_CONCURRENCY=25
CALL_WORKER_MAX_CALL_SEC=900
POST_CALL_WORKER_CONCURRENCY=10
RECORDING_WORKER_CONCURRENCY=5
PER_COMPANY_MAX_CONCURRENT=50
TWILIO_ORIGINATION_RPS=1
TWILIO_MEDIA_STREAM_WS_HOST=

# ---------- Frontend ----------
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/ws
VITE_APP_ENV=development
