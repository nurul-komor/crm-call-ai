{
  "name": "@voiceflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@voiceflow/shared-types": "workspace:*",
    "@voiceflow/shared-utils": "workspace:*",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.19.2",
    "express-rate-limit": "7.4.0",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "1.11.7",
    "mongoose": "8.5.1",
    "multer": "1.4.5-lts.1",
    "papaparse": "5.4.1",
    "nodemailer": "6.9.14",
    "pino": "9.3.1",
    "pino-http": "10.2.0",
    "slugify": "1.6.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/multer": "1.4.11",
    "@types/nodemailer": "6.4.15",
    "@types/papaparse": "5.3.14",
    "@types/supertest": "6.0.2",
    "@voiceflow/shared-config": "workspace:*",
    "mongodb-memory-server": "10.0.0",
    "pino-pretty": "11.2.2",
    "supertest": "7.0.0",
    "tsx": "4.16.2",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
